# Copy to your shell rc (~/.zshrc) and uncomment as needed.

# --- Local Ollama (already running on this machine) ---
# export OLLAMA_HOST=http://localhost:11434
# export OLLAMA_API_KEY=                 # only if Ollama is behind auth

# --- Cloud providers (optional, for mixing models) ---
# export ANTHROPIC_API_KEY=sk-ant-...
# export OPENAI_API_KEY=sk-...
# export GEMINI_API_KEY=...
# export GROQ_API_KEY=...
# export MISTRAL_API_KEY=...

# --- omp model role overrides (alternative to `omp config set`) ---
# export PI_DEFAULT_MODEL=ollama/qwen3-coder:30b
# export PI_SMOL_MODEL=ollama/llama3.1:latest
# export PI_PLAN_MODEL=ollama/qwen3-coder:30b
